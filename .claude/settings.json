{
    "permissions": {
        "allow": [
            "Bash(npm run test:*)",
            "Bash(npm run typecheck)",
            "Bash(npm run lint)",
            "Bash(npm run format)",
            "Bash(npm test)",
            "Bash(npx vitest:*)",
            "Bash(npx tsc:*)",
            "Bash(npx eslint:*)",
            "Bash(npx prettier:*)",
            "Bash(git status)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git branch --list:*)"
        ],
        "deny": [
            "Bash(git commit:*)",
            "Bash(git push:*)",
            "Bash(git checkout -b:*)",
            "Bash(git branch -d:*)",
            "Bash(git branch -D:*)",
            "Bash(git reset:*)"
        ]
    }
}
