  "description": "Backend do Xadrez",
  "main": "index.js",
  "scripts": {
    "start": "node --import tsx index.js",
    "dev": "node --watch --import tsx index.js",
    "ia": "node --import tsx ia.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
