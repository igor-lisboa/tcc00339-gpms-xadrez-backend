/**
 * Writes the per-tool copies of the skills and agents from the shared sources in .agents/.
 *   .agents/skills/<name>/SKILL.md  -> .claude/skills/<name>/SKILL.md, .github/skills/<name>/SKILL.md
 *   .agents/agents/<name>.md        -> .claude/agents/<name>.md, .github/agents/<name>.agent.md, .codex/agents/<name>.toml
 * Codex reads .agents/skills directly. With --check, nothing is written and the exit code is 1 when a copy is stale.
 */
import { existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";

const root = resolve(import.meta.dirname, "..");
const checkOnly = process.argv.includes("--check");
const MARK = "generated by scripts/sync-agent-config.mts from .agents/; edit the source and run npm run sync:agents";

/** Neutral tool names used in .agents/agents, mapped to each tool's own names. */
const CLAUDE_TOOLS: Record<string, string[]> = { read: ["Read"], search: ["Grep", "Glob"], edit: ["Edit", "Write"], execute: ["Bash"] };

interface Parsed {
    readonly fields: Record<string, string>;
    readonly frontmatter: string;
    readonly body: string;
}

const parse = (file: string): Parsed => {
    const match = /^---\n([\s\S]*?)\n---\n([\s\S]*)$/.exec(readFileSync(file, "utf8").replace(/\r\n/g, "\n"));
    if (match === null) {
        throw new Error(`${file}: frontmatter is missing`);
    }
    const fields: Record<string, string> = {};
    for (const line of match[1].split("\n")) {
        const colon = line.indexOf(":");
        if (colon > 0) {
            fields[line.slice(0, colon).trim()] = line.slice(colon + 1).trim();
        }
    }
    return { fields, frontmatter: match[1], body: match[2] };
};

const list = (dir: string): string[] => (existsSync(dir) ? readdirSync(dir).sort() : []);
const sourceAgents = list(join(root, ".agents/agents")).filter((name) => name.endsWith(".md"));
const sourceSkills = list(join(root, ".agents/skills"));

const outputs = new Map<string, string>();
const managedDirs = [".claude/skills", ".github/skills", ".claude/agents", ".github/agents", ".codex/agents"];

for (const name of sourceSkills) {
    const parsed = parse(join(root, ".agents/skills", name, "SKILL.md"));
    const text = `---\n${parsed.frontmatter}\n---\n<!-- ${MARK} -->\n${parsed.body}`;
    for (const target of [".claude/skills", ".github/skills"]) {
        outputs.set(join(root, target, name, "SKILL.md"), text);
    }
}

for (const file of sourceAgents) {
    const parsed = parse(join(root, ".agents/agents", file));
    const { name, description } = parsed.fields;
    const tools = parsed.fields.tools.split(",").map((tool) => tool.trim());
    const claudeTools = tools.flatMap((tool) => CLAUDE_TOOLS[tool] ?? []).filter((tool, index, all) => all.indexOf(tool) === index);
    const copilotTools = tools.map((tool) => `'${tool}'`).join(", ");
    const sandbox = tools.includes("edit") ? "workspace-write" : "read-only";

    outputs.set(
        join(root, ".claude/agents", file),
        `---\nname: ${name}\ndescription: ${description}\ntools: ${claudeTools.join(", ")}\n---\n<!-- ${MARK} -->\n${parsed.body}`
    );
    outputs.set(
        join(root, ".github/agents", file.replace(/\.md$/, ".agent.md")),
        `---\nname: ${name}\ndescription: ${description}\ntools: [${copilotTools}]\n---\n<!-- ${MARK} -->\n${parsed.body}`
    );
    outputs.set(
        join(root, ".codex/agents", file.replace(/\.md$/, ".toml")),
        [
            `# ${MARK}`,
            `name = ${JSON.stringify(name)}`,
            `description = ${JSON.stringify(description)}`,
            `sandbox_mode = "${sandbox}"`,
            `developer_instructions = '''`,
            parsed.body.trimEnd(),
            `'''`,
            "",
        ].join("\n")
    );
}

const normal = (text: string) => text.replace(/\r\n/g, "\n");
const stale: string[] = [];

for (const [file, content] of outputs) {
    const current = existsSync(file) ? normal(readFileSync(file, "utf8")) : null;
    if (current !== normal(content)) {
        stale.push(file);
        if (!checkOnly) {
            mkdirSync(dirname(file), { recursive: true });
            writeFileSync(file, content);
        }
    }
}

// remove generated copies whose source is gone (only files carrying the marker are touched)
for (const target of managedDirs) {
    for (const entry of list(join(root, target))) {
        const path = join(root, target, entry);
        const candidate = entry.endsWith(".md") || entry.endsWith(".toml") ? path : join(path, "SKILL.md");
        if (!outputs.has(candidate) && existsSync(candidate) && normal(readFileSync(candidate, "utf8")).includes(MARK)) {
            stale.push(`${candidate} (no source)`);
            if (!checkOnly) {
                rmSync(target.endsWith("skills") ? path : candidate, { recursive: true, force: true });
            }
        }
    }
}

if (checkOnly) {
    if (stale.length > 0) {
        console.error("Agent copies are out of date. Run npm run sync:agents:\n" + stale.map((file) => `  ${file}`).join("\n"));
        process.exit(1);
    }
    console.log(`Agent copies are up to date (${outputs.size} files).`);
} else {
    console.log(`Synced ${outputs.size} agent files; changed or removed ${stale.length}.`);
}
